        </DeployFile>
        <DeployFile Include="$(BDS)\bin64\sk4d.dll" Condition="'$(Config)'=='Release' And '$(SKIADIR)'==''">
            <RemoteDir>PathwayDesigner_FMX_Project\</RemoteDir>
            <RemoteName>sk4d.dll</RemoteName>
